# Copy to .env and adjust. This file is read by docker-compose's `env_file: .env`
# for the web/worker services, and can also be sourced for local (non-Docker) runs.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Database: oracle (primary) | mysql (fallback) | postgres (last resort) | sqlite (dev only) ---
DB_ENGINE=oracle

# Oracle (used when DB_ENGINE=oracle)
ORACLE_DSN=oracle:1521/FREEPDB1
ORACLE_APP_USER=ticketsurge
ORACLE_APP_PASSWORD=ticketsurge
ORACLE_SYS_PASSWORD=ticketsurge_sys

# MySQL (used when DB_ENGINE=mysql)
MYSQL_DB=ticketsurge
MYSQL_USER=ticketsurge
MYSQL_PASSWORD=ticketsurge
MYSQL_HOST=mysql
MYSQL_PORT=3306

# PostgreSQL (used when DB_ENGINE=postgres — this repo's dev/test-verified fallback)
POSTGRES_DB=ticketsurge
POSTGRES_USER=ticketsurge
POSTGRES_PASSWORD=ticketsurge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Redis: seat holds + Channels layer ---
REDIS_URL=redis://redis:6379/0
REDIS_HOLDS_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2
SEAT_HOLD_TTL_SECONDS=420

# --- Celery / RabbitMQ ---
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_TASK_ALWAYS_EAGER=0

# --- Vercel (set these in the Vercel project's Environment Variables) ---
# VERCEL=1 is set by Vercel itself: DEBUG defaults off and Celery runs
# tasks eagerly (no worker), so CELERY_BROKER_URL is not needed there.
# DJANGO_SECRET_KEY=<long random string>
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # e.g. Neon; overrides DB_ENGINE
# REDIS_URL=rediss://default:pass@host:6379                     # e.g. Upstash; used for holds + channels
